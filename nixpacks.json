{
  "providers": ["node"],
  "nixPkgs": [
    "nodejs_22",
    "python3",
    "ffmpeg",
    "yt-dlp",
    "chromium",
    "xorg.xvfb",
    "xorg.xauth",
    "x11vnc",
    "xterm",
    "nss",
    "atk",
    "at-spi2-atk",
    "cups",
    "libdrm",
    "libxkbcommon",
    "xorg.libXcomposite",
    "xorg.libXdamage",
    "xorg.libXfixes",
    "xorg.libXrandr",
    "mesa",
    "alsa-lib",
    "pango",
    "cairo",
    "libexif"
  ],
  "variables": {
    "NIXPACKS_NODE_VERSION": "22",
    "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD": "true",
    "PUPPETEER_EXECUTABLE_PATH": "/root/.nix-profile/bin/chromium"
  },
  "phases": {
    "setup": {
      "cmds": [
        "ln -sf /root/.nix-profile/bin/python3 /root/.nix-profile/bin/python",
        "ln -sf /nix/var/nix/profiles/default/bin/python3 /nix/var/nix/profiles/default/bin/python || true"
      ]
    }
  },
  "start": {
    "cmd": "xvfb-run --server-args='-screen 0 1280x720x24' node index.js"
  }
}
